# ============================================================
# 1. Dépendances Node.js
# ============================================================

node_modules/
.npm/
.yarn/
.pnpm-store/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================================
# 2. Variables d'environnement et secrets
# ============================================================

# Ignore les véritables configurations, quel que soit leur dossier.
.env
.env.*
*.env
*.env.*

# Les modèles sans secrets doivent rester disponibles sur GitHub.
!.env.example
!**/.env.example

# Configurations locales susceptibles de contenir des identifiants.
config.js
config.local.js
*.local.json
.npmrc

# Dossiers et fichiers de secrets.
secrets/
credentials/
*.secret
*.credentials
credentials*.json
service-account*.json


